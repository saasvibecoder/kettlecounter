  { name: "Facebook", href: "#", d: "M14 22v-8h2.7l.4-3.1H14V9c0-.9.25-1.5 1.55-1.5H17V4.7C16.7 4.66 15.8 4.6 14.7 4.6c-2.3 0-3.9 1.4-3.9 4V11H8v3.1h2.8V22Z" },
