  { name: "X", href: "#", d: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" },
];
---
<ul class:list={["socials", size]}>
  {items.map(i => (
    <li><a href={i.href} aria-label={i.name} title={i.name}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={i.d}/></svg>
    </a></li>
  ))}
</ul>
<style>
.socials{display:flex;gap:10px;list-style:none;margin:0;padding:0}
.socials a{display:flex;align-items:center;justify-content:center;border-radius:50%;text-decoration:none}
.socials.sm a{width:28px;height:28px;background:var(--card);border:1px solid var(--line);color:var(--ink)}
.socials.sm svg{width:14px;height:14px}
.socials.sm a:hover,.socials.sm a:focus-visible{border-color:var(--accent)}
.socials.lg a{width:30px;height:30px;background:#2b3447;color:#e8edf5}
.socials.lg svg{width:15px;height:15px}
.socials.lg a:hover,.socials.lg a:focus-visible{background:#f47c0a;color:#1a0d00}
</style>