---
import { categories } from "../data/menu";
interface Props { slug: string; }
const { slug } = Astro.props;
const cat = categories.find(c => c.slug === slug);
const toSlug = (s: string) => s.toLowerCase().replace(/\s+/g, "-");
---
{cat && (
  <div class="articles">
    <p class="eyebrow">Latest reviews in {cat.name}</p>
    <div class="agrid">
      {cat.subs.map(s => (
        <a class="acard" href={`/${cat.slug}/${toSlug(s)}/`}>
          <div class="thumb" aria-hidden="true"></div>
          <span class="kicker">{s}</span>
          <h4>Best {s} Under $150: Our Top Pick</h4>
          <p>A short meta-description hook goes here, written to pull the reader in before the review.</p>
          <span class="cta">Read review &rarr;</span>
        </a>
      ))}
    </div>
  </div>
)}
<style>
.articles{margin-top:30px}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);font-weight:700;margin:0 0 14px}
.agrid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.acard{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:14px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:6px;min-width:0}
.acard:hover,.acard:focus-visible{border-color:var(--accent)}
.acard .thumb{width:100%;height:100px;border-radius:8px;background:var(--card);border:1px solid var(--line)}
.kicker{font-size:11px;color:var(--mute);text-transform:uppercase;letter-spacing:.04em}
.acard h4{margin:2px 0 0;font-size:14.5px;line-height:1.3}
.acard p{margin:0;font-size:12.5px;color:var(--mute);line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.cta{margin-top:auto;font-size:12.5px;font-weight:600;color:var(--accent)}
@media(max-width:900px){
  .agrid{grid-auto-flow:column;grid-auto-columns:72%;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px}
  .acard{scroll-snap-align:start}
}
</style>