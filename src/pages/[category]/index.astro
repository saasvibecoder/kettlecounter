---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { categories } from "../../data/menu";

export async function getStaticPaths() {
  const toSlug = (s: string) => s.toLowerCase().replace(/\s+/g, "-");
  const entries = await getCollection("reviews");
  return categories.map(c => {
    const subSections = c.subs.map(s => {
      const subSlug = toSlug(s);
      const items = entries.filter(e => e.data.category === c.slug && toSlug(e.data.subNiche) === subSlug);
      const featured = items.find(i => i.data.featured) ?? items[0];
      const rest = items.filter(i => i !== featured).slice(0, 3);
      return { name: s, slug: subSlug, count: items.length, featured, rest };
    });
    return {
      params: { category: c.slug },
      props: { catName: c.name, catSlug: c.slug, subSections },
    };
  });
}

const { catName, catSlug, subSections } = Astro.props;
---
<BaseLayout title={`${catName} Reviews — KettleCounter`} description={`${catName}, reviewed and compared across every sub-niche.`}>
  <div class="catpage">
    <Sidebar />
    <main class="main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span aria-current="page">{catName}</span>
      </nav>

      <h1>{catName}</h1>
      <p class="intro">Our picks for {catName.toLowerCase()}, reviewed and compared. Every review links straight to Amazon.</p>

      {subSections.map((sec, i) => (
        <section class:list={["subsection", { first: i === 0 }]}>
          <div class="subhead">
            <h2><a href={`/${catSlug}/${sec.slug}/`}>{sec.name}</a></h2>
            <span class="count">{sec.count} {sec.count === 1 ? "review" : "reviews"}</span>
            <a class="seeall" href={`/${catSlug}/${sec.slug}/`}>See all &rarr;</a>
          </div>

          {sec.count === 0 && (
            <p class="empty">No articles written yet for {sec.name}.</p>
          )}

          {sec.featured && (
            <div class="row">
              <a class="card featured" href={`/${catSlug}/${sec.slug}/${sec.featured.data.slug}/`}>
                <span class="tag">Editor&rsquo;s Pick</span>
                <div class="thumb" aria-hidden="true"></div>
                <h3>{sec.featured.data.title}</h3>
                <p>{sec.featured.data.hook}</p>
                <span class="cta">Read review &rarr;</span>
              </a>
              {sec.rest.map((i: any) => (
                <a class="card" href={`/${catSlug}/${sec.slug}/${i.data.slug}/`}>
                  <div class="thumb" aria-hidden="true"></div>
                  <h3>{i.data.title}</h3>
                  <p>{i.data.hook}</p>
                  <span class="cta">Read review &rarr;</span>
                </a>
              ))}
            </div>
          )}
        </section>
      ))}
    </main>
  </div>
</BaseLayout>

<style>
.catpage{display:flex;align-items:flex-start}
.main{flex:1;padding:28px 20px 60px;max-width:1100px}
.crumbs{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mute);margin:0 0 18px}
.crumbs a{color:var(--mute);text-decoration:none}
.crumbs a:hover{color:var(--accent)}
.crumbs span{opacity:.6}
.crumbs [aria-current]{color:var(--ink);font-weight:600;opacity:1}
h1{font-size:clamp(28px,4.5vw,42px);margin:0 0 12px}
.intro{color:var(--mute);max-width:65ch;margin:0 0 20px}

.subsection{padding:30px 0;border-top:3px solid transparent;border-image:linear-gradient(90deg,#0a0a0a,#8a1414,#d94f16,#f2b33d) 1}
.subsection.first{border-top:none;padding-top:10px}
.subhead{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.subhead h2{margin:0;font-size:22px}
.subhead h2 a{color:var(--ink);text-decoration:none}
.subhead h2 a:hover{color:var(--accent)}
.count{font-size:13px;color:var(--mute)}
.seeall{margin-left:auto;font-size:13px;font-weight:600;color:var(--accent);text-decoration:none}
.seeall:hover{text-decoration:underline}
.empty{color:var(--mute);background:var(--card);border:1px dashed var(--line);border-radius:10px;padding:14px;font-size:14px}

.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:6px}
.card:hover{border-color:var(--accent)}
.card.featured{border-color:var(--accent)}
.tag{position:absolute;top:10px;left:10px;background:var(--hi);color:#2a1d00;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:3px 8px;border-radius:999px;z-index:1}
.thumb{width:100%;height:90px;border-radius:8px;background:var(--bg);border:1px solid var(--line)}
.card h3{margin:2px 0 0;font-size:14.5px;line-height:1.3}
.card p{margin:0;font-size:12.5px;color:var(--mute);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.cta{margin-top:auto;font-size:12.5px;font-weight:600;color:var(--accent)}
@media(max-width:800px){.catpage{flex-direction:column}}
</style>