---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import { categories } from "../../../data/menu";

export async function getStaticPaths() {
  const toSlug = (s: string) => s.toLowerCase().replace(/\s+/g, "-");
  const entries = await getCollection("reviews");
  const paths = [];
  for (const c of categories) {
    for (const s of c.subs) {
      const subSlug = toSlug(s);
      const items = entries.filter(e => e.data.category === c.slug && toSlug(e.data.subNiche) === subSlug);
      paths.push({
        params: { category: c.slug, subniche: subSlug },
        props: { catName: c.name, catSlug: c.slug, subName: s, subSlug, items },
      });
    }
  }
  return paths;
}

const { catName, catSlug, subName, subSlug, items } = Astro.props;
const featured = items.find((i: any) => i.data.featured) ?? items[0];
const rest = items.filter((i: any) => i !== featured);
---
<BaseLayout title={`Best ${subName} Reviews — KettleCounter`} description={`Our picks for ${subName.toLowerCase()}, compared and reviewed.`}>
  <div class="catpage">
    <Sidebar />
    <main class="main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href={`/${catSlug}/`}>{catName}</a><span>/</span>
        <span aria-current="page">{subName}</span>
      </nav>

      <h1>Best {subName}</h1>
      <p class="intro">{items.length} {items.length === 1 ? "review" : "reviews"} in this sub-niche, reviewed and compared. Every pick links to Amazon.</p>

      {items.length === 0 && (
        <p class="empty">No articles written for this sub-niche yet. Add a .md file in src/content/reviews/ with category: "{catSlug}" and subNiche: "{subName}" to see it here.</p>
      )}

      {featured && (
        <a class="featured" href={`/${catSlug}/${subSlug}/${featured.data.slug}/`}>
          <span class="tag">Editor&rsquo;s Pick</span>
          <div class="fthumb" aria-hidden="true"></div>
          <div class="fbody">
            <h2>{featured.data.title}</h2>
            <p>{featured.data.hook}</p>
            <span class="cta">Read full review &rarr;</span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="grid">
          {rest.map((i: any) => (
            <a class="card" href={`/${catSlug}/${subSlug}/${i.data.slug}/`}>
              <div class="thumb" aria-hidden="true"></div>
              <h3>{i.data.title}</h3>
              <p>{i.data.hook}</p>
              <span class="cta">Read review &rarr;</span>
            </a>
          ))}
        </div>
      )}
    </main>
  </div>
</BaseLayout>

<style>
.catpage{display:flex;align-items:flex-start}
.main{flex:1;padding:28px 20px 60px;max-width:1000px}
.crumbs{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mute);margin:0 0 18px}
.crumbs a{color:var(--mute);text-decoration:none}
.crumbs a:hover{color:var(--accent)}
.crumbs span{opacity:.6}
.crumbs [aria-current]{color:var(--ink);font-weight:600;opacity:1}
h1{font-size:clamp(28px,4.5vw,42px);margin:0 0 10px}
.intro{color:var(--mute);margin:0 0 26px}
.empty{color:var(--mute);background:var(--card);border:1px dashed var(--line);border-radius:10px;padding:16px;font-size:14px}
.featured{display:grid;grid-template-columns:1fr 1.3fr;gap:20px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;text-decoration:none;color:var(--ink);margin-bottom:24px;position:relative}
.tag{position:absolute;top:14px;left:18px;background:var(--hi);color:#2a1d00;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:4px 10px;border-radius:999px}
.fthumb{width:100%;min-height:160px;border-radius:10px;background:var(--bg);border:1px solid var(--line)}
.fbody{display:flex;flex-direction:column;justify-content:center;gap:8px}
.fbody h2{margin:14px 0 0;font-size:20px}
.fbody p{margin:0;color:var(--mute);font-size:14px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:8px}
.card:hover,.featured:hover{border-color:var(--accent)}
.thumb{width:100%;height:100px;border-radius:8px;background:var(--bg);border:1px solid var(--line)}
.card h3{margin:0;font-size:15px}
.card p{margin:0;color:var(--mute);font-size:13px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.cta{font-size:13px;font-weight:600;color:var(--accent)}
@media(max-width:800px){.catpage{flex-direction:column}.featured{grid-template-columns:1fr}}
</style>